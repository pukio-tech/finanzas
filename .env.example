# Copia este archivo como .env y completa los valores.

# PostgreSQL local. Crea antes una base vacía llamada "finanzas".
DATABASE_URL="postgresql://postgres:TU_CONTRASEÑA@localhost:5432/finanzas?schema=public"

# Clave para cifrar la cookie de sesión (mínimo 32 caracteres).
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_PASSWORD=""

# Almacenamiento S3 (o compatible, como Neon) para los vouchers. El bucket debe ser privado.
# AWS_ENDPOINT_URL_S3 se deja vacío si usas AWS S3 directamente.
AWS_ENDPOINT_URL_S3=""
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET=""
