generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Todo dato pertenece a un usuario: ninguna cuenta ve datos de otra.

model Usuario {
  id           String   @id @default(cuid())
  nombre       String
  email        String   @unique
  passwordHash String
  creadoEn     DateTime @default(now())

  plan       PlanAhorro?
  ingresos   Ingreso[]
  metas      Meta[]
  deudas     Deuda[]
  categorias Categoria[]
  pagos      Pago[]
}

// Ahorro actual y gastos fijos del mes; junto con los ingresos alimentan la proyección.
model PlanAhorro {
  id            String   @id @default(cuid())
  usuarioId     String   @unique
  ahorroActual  Decimal  @default(0) @db.Decimal(12, 2)
  // Lo que gastas cada mes de tus ingresos (lo que no ahorras).
  gastoMensual  Decimal  @default(0) @db.Decimal(12, 2)
  actualizadoEn DateTime @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

// Ingreso mensual (ej. sueldo de S/ 900). Cada mes desde `desde` espera `montoMensual`,
// salvo que un ajuste diga otro monto para ese mes.
model Ingreso {
  id           String    @id @default(cuid())
  usuarioId    String
  nombre       String
  montoMensual Decimal   @db.Decimal(12, 2)
  desde        DateTime  @db.Date
  hasta        DateTime? @db.Date
  creadoEn     DateTime  @default(now())

  usuario Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  ajustes AjusteIngreso[]
  cobros  Cobro[]

  @@index([usuarioId])
}

// Monto distinto para un mes concreto (0 = ese mes no hay ingreso).
model AjusteIngreso {
  id        String  @id @default(cuid())
  ingresoId String
  anio      Int
  mes       Int
  monto     Decimal @db.Decimal(12, 2)

  ingreso Ingreso @relation(fields: [ingresoId], references: [id], onDelete: Cascade)

  @@unique([ingresoId, anio, mes])
}

// Dinero recibido; se aplica al mes pendiente más antiguo.
model Cobro {
  id        String   @id @default(cuid())
  ingresoId String
  fecha     DateTime @db.Date
  monto     Decimal  @db.Decimal(12, 2)
  nota      String?
  creadoEn  DateTime @default(now())

  ingreso Ingreso @relation(fields: [ingresoId], references: [id], onDelete: Cascade)

  @@index([ingresoId])
}

enum EstadoMeta {
  ACTIVA
  COMPLETADA
  CANCELADA
}

// Artículo a comprar o pago a cubrir (universidad, laptop...).
model Meta {
  id            String     @id @default(cuid())
  usuarioId     String
  nombre        String
  montoObjetivo Decimal    @db.Decimal(12, 2)
  prioridad     Int        @default(0)
  fechaObjetivo DateTime?  @db.Date
  icono         String?
  notas         String?
  estado        EstadoMeta @default(ACTIVA)
  creadoEn      DateTime   @default(now())

  usuario Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  aportes AporteMeta[]

  @@index([usuarioId])
}

model AporteMeta {
  id     String   @id @default(cuid())
  metaId String
  fecha  DateTime @db.Date
  monto  Decimal  @db.Decimal(12, 2)
  nota   String?
  // Si el aporte vino de un pago realizado.
  pagoId String?  @unique

  meta Meta  @relation(fields: [metaId], references: [id], onDelete: Cascade)
  pago Pago? @relation(fields: [pagoId], references: [id], onDelete: Cascade)

  @@index([metaId])
}

enum TipoDeuda {
  DEBO
  ME_DEBEN
}

model Deuda {
  id          String    @id @default(cuid())
  usuarioId   String
  tipo        TipoDeuda
  contraparte String
  descripcion String?
  monto       Decimal   @db.Decimal(12, 2)
  fecha       DateTime  @db.Date
  fechaLimite DateTime? @db.Date
  creadoEn    DateTime  @default(now())

  usuario Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  abonos  AbonoDeuda[]

  @@index([usuarioId])
}

model AbonoDeuda {
  id      String   @id @default(cuid())
  deudaId String
  fecha   DateTime @db.Date
  monto   Decimal  @db.Decimal(12, 2)
  nota    String?
  // Si el abono vino de un pago realizado.
  pagoId  String?  @unique

  deuda Deuda @relation(fields: [deudaId], references: [id], onDelete: Cascade)
  pago  Pago? @relation(fields: [pagoId], references: [id], onDelete: Cascade)

  @@index([deudaId])
}

model Categoria {
  id        String  @id @default(cuid())
  usuarioId String
  nombre    String
  icono     String?

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  pagos   Pago[]

  @@unique([usuarioId, nombre])
}

enum MetodoPago {
  EFECTIVO
  YAPE
  PLIN
  TRANSFERENCIA
  TARJETA
  OTRO
}

// Pagos realizados (universidad, compras...) con voucher opcional en S3.
model Pago {
  id          String     @id @default(cuid())
  usuarioId   String
  categoriaId String?
  fecha       DateTime   @db.Date
  monto       Decimal    @db.Decimal(12, 2)
  descripcion String
  metodo      MetodoPago @default(EFECTIVO)
  voucherKey  String?
  voucherTipo String?
  creadoEn    DateTime   @default(now())

  usuario   Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  categoria Categoria?  @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  aporte    AporteMeta?
  abono     AbonoDeuda?

  @@index([usuarioId, fecha])
}
